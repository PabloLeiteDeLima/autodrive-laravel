APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:GERAR_UMA_CHAVE_DEPOIS_SE_PRECISO
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Configurações cruciais para o PostgreSQL no Docker
DB_CONNECTION=pgsql
DB_HOST=db               # Este nome deve ser idêntico ao nome do serviço no docker-compose
DB_PORT=5432
DB_DATABASE=laravel_db
DB_USERNAME=laravel_user
DB_PASSWORD=laravel_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
